[Unit]
Description=Tank Robot Autonomous Agent Service
After=network.target tank-control.service

[Service]
Type=simple
User=ixaxaar
Group=ixaxaar
WorkingDirectory=/home/ixaxaar/tank-agent
ExecStart=/usr/bin/python3 /home/ixaxaar/tank-agent/src/autonomous_agent.py
Restart=always
RestartSec=10
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target