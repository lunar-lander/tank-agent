[Unit]
Description=Tank Robot Web Control Service
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/tank-agent
ExecStart=/usr/bin/python3 /opt/tank-agent/src/web_control.py
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
