[Unit]
Description=Tank Robot Camera Stream Service
After=network.target

[Service]
Type=simple
User=ixaxaar
Group=ixaxaar
WorkingDirectory=/home/ixaxaar/tank-agent
ExecStart=/usr/bin/python3 /home/ixaxaar/tank-agent/utils/camera_stream.py
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target